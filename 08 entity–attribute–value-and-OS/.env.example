# PostgreSQL — the write model / source of truth
POSTGRES_HOST=localhost
POSTGRES_PORT=5480
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eav_os_demo

# OpenSearch — the read model
OPENSEARCH_NODE=http://localhost:9280
OPENSEARCH_INDEX=products

# REST API / UI
API_PORT=3080

# Sync worker (outbox -> OpenSearch indexer)
SYNC_INTERVAL_MS=1000
SYNC_BATCH=500
BULK_SIZE=1000

# Seeding
SEED_PRODUCTS=30000
SEED_DEFAULT_CATEGORY=laptops

# Debug logging (write · outbox · sync · os · api · read).
# On by default. Silence with DEBUG=0, or filter to tags: DEBUG=sync,outbox
DEBUG=1
